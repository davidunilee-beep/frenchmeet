{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/downloads/Bonjour.url",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Bonjour.url\"" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
    }
  ]
}
